# Copy to .env and fill in. Never commit .env or paste these values into chat.

# From https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Enable Developer Mode in Discord (Settings → Advanced), then right-click → Copy ID.
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# With docker compose this is set for you. For a local Postgres:
DATABASE_URL=postgres://commonplace:commonplace@localhost:5432/commonplace

# Used to read dates you type in commands, e.g. America/Los_Angeles
TIMEZONE=UTC

# Reaction added to your messages once saved. Leave empty for no acknowledgment.
ACK_REACTION=🗂️
